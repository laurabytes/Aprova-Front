{
  "expo": {
    "name": "aprova-app",
    "slug": "aprova-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/mascote.png", // ALTERADO: Usa o Mascote como ícone principal (se você renomeá-lo para icon.png, não precisa mudar o caminho)
    "scheme": "aprovaapp",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        // MANTIDO: Estas referências são para ícones adaptativos do Android e não são logos do Expo. 
        // Se desejar usá-las, você precisará gerar versões com o mascote. Por enquanto, mantemos as originais.
        "foregroundImage": "./assets/images/android-icon-foreground.png", 
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          // ALTERADO: Substitui a imagem splash do Expo pela imagem mascote
          "image": "./assets/images/mascote.png", 
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}